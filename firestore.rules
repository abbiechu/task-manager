rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user may only read and write their own profile and data.
    match /users/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;

      match /{userCollection}/{documentId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId
          && userCollection in ['tasks', 'activityDays', 'courses'];
      }

      // Store an enforceable, per-user daily cap for client-side Gemini calls.
      match /geminiUsage/{dateKey} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['dateKey', 'count'])
          && request.resource.data.dateKey == dateKey
          && request.resource.data.count is int
          && request.resource.data.count == 1;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['dateKey', 'count'])
          && resource.data.dateKey == dateKey
          && request.resource.data.dateKey == dateKey
          && resource.data.count is int
          && request.resource.data.count is int
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count <= 20;
        allow delete: if false;
      }
    }
  }
}
